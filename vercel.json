{
  "buildCommand": "sh scripts/build-site.sh",
  "outputDirectory": "site",
  "installCommand": "",
  "framework": null,
  "cleanUrls": false,
  "headers": [
    { "source": "/(.*)\\.(sh|py|swift)", "headers": [
      { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
      { "key": "Cache-Control", "value": "public, max-age=300" }
    ]}
  ]
}
